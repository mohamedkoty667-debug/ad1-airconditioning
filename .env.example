# Copy this file to ".env.local" (on your computer) or add these in Vercel → Settings → Environment Variables.

# Quote form email (free account at https://resend.com → API Keys)
RESEND_API_KEY=
# Where quote requests are sent (defaults to the email in src/lib/site.ts)
QUOTE_TO_EMAIL=
# Sender address. Leave empty until you verify your own domain in Resend.
QUOTE_FROM_EMAIL=

# Your live website address, e.g. https://www.ad1airconditioning.co.uk (used for Google and link previews)
NEXT_PUBLIC_SITE_URL=
